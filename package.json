{
  "name": "axelar-local-dev",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "hardhat clean && hardhat compile",
    "prettier": "prettier --write 'src/**/*.ts'",
    "test": "hardhat test src/__tests__/Factory.spec.ts src/__tests__/DepositFactory.spec.ts src/__tests__/BeefyHelper.spec.ts src/__tests__/RemoteAccountCreation.spec.ts src/__tests__/RemoteAccountMulticall.spec.ts src/__tests__/RemoteAccountDeposit.spec.ts src/__tests__/RemoteAccountRouter.spec.ts src/__tests__/RemoteAccountVetting.spec.ts src/__tests__/RemoteAccountDeploy.spec.ts src/__tests__/CreateXGuard.spec.ts src/__tests__/CreateXDeploy.spec.ts src/__tests__/BuildArtifacts.spec.ts",
    "coverage": "hardhat coverage --testfiles src/__tests__/Factory.spec.ts",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "verify": "./scripts/verify.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:all": "cd integration && npx --silent vite-node deploy-all-chains.ts",
    "decode": "cd integration && npx --silent vite-node decode-payload.ts",
    "check-balance": "cd integration && npx --silent vite-node check-wallet-balance.ts",
    "sync-nonces": "npx ts-node scripts/increment-nonce.ts",
    "check-gas": "npx ts-node scripts/check-gas-price.ts"
  },
  "dependencies": {
    "@axelar-network/axelar-gmp-sdk-solidity": "^5.6.2",
    "@openzeppelin/contracts": "^5.3.0",
    "createx-factory": "github:pcaversaccio/createx",
    "solmate": "^6.8.0"
  },
  "devDependencies": {
    "@axelar-network/axelar-cgp-solidity": "^6.3.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.11",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.11",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^10.0.10",
    "@updated-axelar-network/axelar-gmp-sdk-solidity": "npm:@axelar-network/axelar-gmp-sdk-solidity@^6.0.6",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.4",
    "hardhat": "^2.23.0",
    "hardhat-gas-reporter": "^1.0.8",
    "prettier": "^3.6.2",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "~5.8.2",
    "viem": "^2.31.6"
  }
}
